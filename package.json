{
  "name": "storage-tree",
  "productName": "Storage Tree",
  "version": "1.6.0",
  "private": true,
  "description": "See what fills a disk: folder tree, treemap, largest files and file types for folders on this PC and for an Android phone over USB or Wi-Fi (through adb). Delete to the Recycle Bin, copy phone files to the PC.",
  "author": "Kenny Wong",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js --open",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "app": "node scripts/make-icon.mjs --if-missing && electron .",
    "dist": "node scripts/make-icon.mjs && node scripts/bundle-adb.mjs && electron-builder --win nsis",
    "icon": "node scripts/make-icon.mjs"
  },
  "main": "electron/main.js",
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.kenny-wong.storage-tree",
    "productName": "Storage Tree",
    "copyright": "Copyright © 2026 Kenny Wong",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "electron/**",
      "api/**",
      "lib/**",
      "public/**",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/adb",
        "to": "adb"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Storage Tree",
      "artifactName": "Storage-Tree-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
